{
  "name": "mcsh-visual",
  "displayName": "Mcsh-Visual",
  "description": "Visual-editor for dirMcsh Mcs*/Hitp*.last.html files. Renders the live local-server page, lets you edit the whole page, and on Save re-serializes the WHOLE document to the canonical 2/4-space Mcsh format.",
  "version": "0.4.0",
  "date": "2026-09-10",
  "publisher": "synagonism",
  "private": true,
  "license": "MIT",
  "icon": "media/icon128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/synagonism/dirMcshmgr"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mcshv.currentFile",
    "onCommand:mcshv.currentFileDirname",
    "onCommand:mcshv.currentFileBasename",
    "onCommand:mcshv.currentWorldview"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mcshv.editorVisual",
        "displayName": "Mcsh-Visual",
        "selector": [
          {
            "filenamePattern": "Mcs*.last.html"
          },
          {
            "filenamePattern": "Hitp*.last.html"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mcshv.open",
        "title": "Open in Mcsh-Visual",
        "category": "Mcs",
        "icon": "media/icon.png"
      },
      {
        "command": "mcshv.openByCode",
        "title": "Open McsHitp file by code",
        "category": "Mcs"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mcshv.open",
          "when": "resourceExtname == .html && resourceFilename =~ /\\.last\\.html$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Mcsh-Visual",
      "properties": {
        "mcshv.serverOrigin": {
          "type": "string",
          "default": "http://localhost",
          "description": "Origin of the local web server that renders the pages (e.g. http://localhost)."
        },
        "mcshv.docRootFolder": {
          "type": "string",
          "default": "dirNodews",
          "description": "Folder name in the file path that marks the server document-root. The URL path is everything after it. Defaults to 'dirNodews' to match server.mjs (web root = C:\\dirNodews)."
        },
        "mcshv.keybindingsPath": {
          "type": "string",
          "default": "",
          "description": "Path to your VS Code keybindings.json. The viewer auto-syncs its wrap/insert chord shortcuts from it. Leave empty to use the default per-OS user path."
        }
      }
    }
  },
  "dependencies": {
    "parse5": "^7.1.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0"
  }
}
