{
  "key": "ctrl+alt+p i d s",
  "command": "mcshv.inhSpecialize",
  "when": "editorTextFocus"
},
// p i d j :: hitP Inheritance Do specialize-Join: a-join writes every attribute it renumbers, then its NN_last
{
  "key": "ctrl+alt+p i d j",
  "command": "mcshv.inhSpecializeJoin",
  "when": "editorTextFocus"
},
// p i d d :: hitP Inheritance Do Delete-empty: the-inherited attributes that say nothing
{
  "key": "ctrl+alt+p i d d",
  "command": "mcshv.inhDeleteEmpty",
  "when": "editorTextFocus"
},
// p i d m :: hitP Inheritance Do (re)naMe: the-attribute word, here and in the-specifics
{
  "key": "ctrl+alt+p i d m",
  "command": "mcshv.inhRename",
  "when": "editorTextFocus"
},
// p i g g :: hitP Inheritance Go Generic: the-generic attribute (or concept)
{
  "key": "ctrl+alt+p i g g",
  "command": "mcshv.inhGoGeneric",
  "when": "editorTextFocus"
},
// p i g s :: hitP Inheritance Go Specific: the-attribute in the-specifics (or the-specifics)
{
  "key": "ctrl+alt+p i g s",
  "command": "mcshv.inhGoSpecific",
  "when": "editorTextFocus"
},
// p i g l :: hitP Inheritance Generic List: the-attributes the-concept inherits
{
  "key": "ctrl+alt+p i g l",
  "command": "mcshv.inhShow",
  "when": "editorTextFocus"
},
// HITP VERSIONING
// p v 1:: hitP saVe major versioning
// p v 2:: hitP saVe minor versioning
{
  "key": "ctrl+alt+p v 2",
  "command": "runCommands",
  "args": {
    "commands": [
      "cursorTop",
      { "command": "editor.actions.findWithArgs",
        "args": { 
          "searchString": "<title>",
          "isRegex": false, "matchWholeWord": false,
          "isCaseSensitive": false, "findInSelection": false
         }
      },
      { "command": "editor.actions.findWithArgs",
        "args": { 
          "searchString": "\\((?:Mcs|Hitp)[^-\n]+-",
          "isRegex": true, "matchWholeWord": false,
          "isCaseSensitive": false, "findInSelection": false
         }
      },
      "editor.action.nextMatchFindAction",
      "cursorRight",
      "closeFindWidget",
      {"command": "type", "args": {"text": " "}},
      "cursorWordEndRight",
      { "command": "type", "args": { "text": " " } },
      "cursorLeft",
      "cursorWordLeftSelect",
      "editor.emmet.action.incrementNumberByOne",
      "cursorLeft",
      "deleteLeft",
      "cursorWordEndRight",
      "deleteRight",
      "cursorWordEndRight",
      "cursorRight",
      "cursorWordEndRightSelect",
      "cursorWordEndRightSelect",
      "cursorWordEndRightSelect",
      "deleteRight",
      { "command": "editor.action.insertSnippet",
        "args": { "snippet": "${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}" }
      }
    ]
  }
},
// p v 3:: hitP saVe patch versioning

// p x u:: hitP indeX names of current-file and Upload
{
  "key": "ctrl+alt+p x u",
  "command": "workbench.action.tasks.runTask",
  "args": "Index names of current-FILE and upload",
  "when": "resourceFilename =~ /\\.last\\.html$/"
},
// p x o:: hitP indeX names Only of current-file (no upload)
{
  "key": "ctrl+alt+p x o",
  "command": "workbench.action.tasks.runTask",
  "args": "Index names ONLY of current-FILE",
  "when": "resourceFilename =~ /\\.last\\.html$/"
},

// =================================
// ctrl+alt+t:: user input EXTENSION

// CUSTOM VSCODE SHORTCUTS
// ctrl+alt+u:: shows char Unicode-codepoint in different formats
{
  "key": "ctrl+alt+u", 
  "command": "codepoint.describe",
  "when": "editorTextFocus"
},
// ctrl+alt+\:: selectToBracket
{
  "key": "ctrl+alt+\\",
  "command": "editor.action.selectToBracket"
},
// shift+alt+\:: matchTag
{
  "key": "shift+alt+\\",
  "command": "editor.emmet.action.matchTag"
},
// ctrl+shift+alt+backspace:: go parent fold
{
  "key": "ctrl+shift+alt+backspace",
  "command": "editor.gotoParentFold",
  "when": "editorTextFocus"
},
// ctrl+shift+alt+\:: go next fold
{
  "key": "ctrl+shift+alt+\\",
  "command": "editor.gotoNextFold"
},

// V:: VALIDATE (Mcsh-visual-manager, valid menu)
// v c c:: Validate Concept: the-concept of the-URL bar (or another), every rule, report or fix unambiguous and report
{
  "key": "ctrl+alt+v c c",
  "command": "mcshv.validConcept"
},
// v c r:: Validate Concept with Rule: the-concept of the-URL bar (or another), a-rule, report or fix and report
{
  "key": "ctrl+alt+v c r",
  "command": "mcshv.validConceptRule"
},
// v f f:: hitP Validate current File, focus the report in the browser (same as visual Valid → Validate-current)
{
  "key": "ctrl+alt+v f f",
  "command": "mcshv.validCurrent",
  "when": "resourceFilename =~ /\\.last\\.html$/"
},
// v f r:: Validate File with Rule: choose a-rule, report or fix and report
{
  "key": "ctrl+alt+v f r",
  "command": "mcshv.validRule"
},
// v d d:: Validate Directory: the-current dir (or choose one), every rule, report or fix unambiguous and report
{
  "key": "ctrl+alt+v d d",
  "command": "mcshv.validDir"
},
// v d r:: Validate Directory with Rule: the-current dir (or choose one), a-rule, report or fix and report
{
  "key": "ctrl+alt+v d r",
  "command": "mcshv.validDirRule"
},
// v w w:: Validate Worldview: the-current worldview prefilled, every rule, report or fix unambiguous and report
{
  "key": "ctrl+alt+v w w",
  "command": "mcshv.validWorld"
},
// v w r:: Validate Worldview with Rule: every file, a-rule, report or fix and report
{
  "key": "ctrl+alt+v w r",
  "command": "mcshv.validWorldRule"
},
// v l l:: Validate List: the-files and dirs of dirManager/validate.txt, every rule, report or fix unambiguous and report
{
  "key": "ctrl+alt+v l l",
  "command": "mcshv.validList"
},
// v l r:: Validate List with Rule: the-files and dirs of dirManager/validate.txt, a-rule, report or fix and report
{
  "key": "ctrl+alt+v l r",
  "command": "mcshv.validListRule"
},


